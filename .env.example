# Data-Agent environment configuration.
# Copy to .env and fill in values. NEVER commit the real .env file.

# --- Dremio ---
# Base URI of your Dremio coordinator (Software). For the bundled dev stack:
DREMIO_URI=http://localhost:9047
# Admin credentials used only by the bootstrap script (scripts/bootstrap_dremio.py).
# Runtime pipeline access should use the read-only account below instead.
DREMIO_ADMIN_USER=dremio_admin
DREMIO_ADMIN_PASSWORD=change-me-bootstrap
# Read-only service account used for all generated-query execution.
DREMIO_USER=dataagent_ro
DREMIO_PASSWORD=change-me-readonly
# Postgres source connection (read-only role) created by docker/seed scripts.
DREMIO_RO_DB_USER=dremio_ro
DREMIO_RO_DB_PASSWORD=ro-password
# Personal access token (preferred over user/password at runtime). Optional.
DREMIO_PAT=

# --- LLM provider (OpenAI Chat-Completions compatible) ---
# GLM_MODE selects the provider implementation:
#   opencode — OpenCode Go subscription (recommended if you have it)
#   zai      — Z.AI / Zhipu direct API
#   mock     — deterministic offline client for dev/tests
# OpenCode Go: base https://opencode.ai/inference/go/openai/v1
#   Key from OPENCODE_API_KEY or opencode's auth store (`/connect` provider
#   opencode-go). Verify with `dataagent llm-check`.
# Z.AI direct: base https://api.z.ai/api/paas/v4 (CN: open.bigmodel.cn/api/paas/v4)
GLM_MODE=opencode
OPENCODE_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_API_KEY=your-glm-api-key
# Verified model ids:
#   OpenCode Go: glm-5.3 | glm-5.3-flash | glm-5.2 | glm-5.1
#   Z.AI direct: glm-5.3 | glm-5.3-flash
GLM_MODEL=glm-5.3-flash
# Reasoning effort (glm-5.3 family): low | high | max
GLM_REASONING_EFFORT=low

# --- Pipeline controls ---
# Execution of candidate SQL is opt-in until validation is complete.
ENABLE_QUERY_EXECUTION=true
QUERY_TIMEOUT_SECONDS=60
QUERY_MAX_ROWS=100
GENERATION_BATCH_SIZE=25
MAX_CORRECTION_RETRIES=2
# Parallel workers for SQL generation / execution / review phases
PIPELINE_WORKERS=4
DATASET_VERSION=0.1.0
SEMANTIC_DEDUP_ENABLED=false
